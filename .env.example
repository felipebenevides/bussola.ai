# ============================================================
# Bússola — variáveis de ambiente
# ============================================================
# A maioria das credenciais (OpenAI, CEFIS demo key, modelos) é
# configurada via /admin (backoffice em banco).
# Apenas o essencial fica em env: conexão Supabase e senha do admin.

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# Backoffice (obrigatório)
ADMIN_PASSWORD=troque-isto-no-deploy

# Opcional — fallback se /admin não foi configurado ainda
OPENAI_API_KEY=
CEFIS_DEMO_API_KEY=
