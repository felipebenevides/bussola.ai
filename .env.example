# ============================================================
# Bússola — variáveis de ambiente
# ============================================================
# A maioria das credenciais (OpenAI, CEFIS demo key, modelos) é
# configurada via /admin (backoffice em banco).
# Apenas o essencial fica em env: conexão Supabase e senha do admin.

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# Backoffice (obrigatório)
ADMIN_PASSWORD=troque-isto-no-deploy

# OpenRouter — provider primário para chat (LLM). Se ausente, cai para OpenAI direto.
OPENROUTER_API_KEY=

# Google AI Studio — provider primário para embeddings (gemini-embedding-001 @ 1536-dim).
# Se ausente, cai para OpenAI (text-embedding-3-small). NÃO misture: vetores não são comparáveis.
GOOGLE_API_KEY=

# OpenAI — fallback de chat E provider de Whisper (áudio → texto, sem alternativa atual).
# Também é fallback de embeddings se GOOGLE_API_KEY não estiver setada.
OPENAI_API_KEY=
CEFIS_DEMO_API_KEY=

# WhatsApp service (Bun em Railway) — só obrigatório se WhatsApp estiver ligado
WA_SERVICE_URL=
INTERNAL_HMAC_SECRET=
